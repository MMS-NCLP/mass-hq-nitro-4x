{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mass-hq.example/schemas/app-015/plugin-manifest-v1.json",
  "title": "MASS Plugin Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "canonicalName", "displayName", "classification", "publisher", "version", "compatibility", "capabilities", "permissions", "documentation", "provenance"],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "canonicalName": {"type": "string", "pattern": "^[a-z][a-z0-9]*(\\.[a-z0-9-]+)+$", "maxLength": 160},
    "displayName": {"type": "string", "minLength": 1, "maxLength": 120},
    "description": {"type": "string", "maxLength": 2000},
    "classification": {"enum": ["internal", "organization", "partner", "third_party"]},
    "publisher": {"type": "object", "additionalProperties": false, "required": ["id", "name"], "properties": {"id": {"type": "string", "format": "uuid"}, "name": {"type": "string"}, "supportUrl": {"type": "string", "format": "uri"}}},
    "version": {"type": "string", "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-[0-9A-Za-z.-]+)?$"},
    "compatibility": {"type": "object", "additionalProperties": false, "required": ["massVersion"], "properties": {"massVersion": {"type": "string"}, "applications": {"type": "array", "items": {"$ref": "#/$defs/dependency"}}, "engines": {"type": "array", "items": {"$ref": "#/$defs/dependency"}}}},
    "capabilities": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/capability"}},
    "dependencies": {"type": "array", "items": {"$ref": "#/$defs/dependency"}},
    "permissions": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "tenantEligibility": {"type": "object", "properties": {"installationScopes": {"type": "array", "items": {"enum": ["organization", "workspace", "project", "user"]}}, "requiredEntitlements": {"type": "array", "items": {"type": "string"}}}},
    "documentation": {"type": "object", "required": ["overview"], "properties": {"overview": {"type": "string", "format": "uri"}, "support": {"type": "string", "format": "uri"}, "changelog": {"type": "string", "format": "uri"}}},
    "provenance": {"type": "object", "required": ["digest", "signatureRef"], "properties": {"digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}, "signatureRef": {"type": "string"}, "buildRef": {"type": "string"}}},
    "deprecation": {"type": "object", "properties": {"deprecated": {"type": "boolean", "default": false}, "replacement": {"type": "string"}, "endOfSupport": {"type": "string", "format": "date-time"}}},
    "extensions": {"type": "object", "propertyNames": {"pattern": "^[a-z][a-z0-9.-]+$"}}
  },
  "$defs": {
    "dependency": {"type": "object", "additionalProperties": false, "required": ["kind", "id", "versionRange"], "properties": {"kind": {"enum": ["required", "optional", "peer", "conflict"]}, "id": {"type": "string"}, "versionRange": {"type": "string"}}},
    "capability": {"type": "object", "additionalProperties": false, "required": ["id", "type", "purpose", "inputs", "outputs", "errors", "sideEffects", "permissions", "approval", "entryPoint", "consumedContracts", "documentation"], "properties": {"id": {"type": "string", "pattern": "^[a-z][a-z0-9.-]+$"}, "type": {"enum": ["tool", "workflow", "agent", "template", "knowledge", "dashboard", "form", "event", "integration"]}, "purpose": {"type": "string"}, "inputs": {"type": "object"}, "outputs": {"type": "object"}, "errors": {"type": "array", "items": {"type": "string"}}, "sideEffects": {"type": "array", "items": {"enum": ["none", "internal_write", "external_write", "communication", "financial", "security", "operational"]}}, "permissions": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}, "approval": {"enum": ["none", "user_confirmation", "steward", "administrator", "executive"]}, "entryPoint": {"type": "string"}, "timeoutMs": {"type": "integer", "minimum": 1}, "idempotent": {"type": "boolean"}, "consumedContracts": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}, "documentation": {"type": "object", "additionalProperties": false, "required": ["overview"], "properties": {"overview": {"type": "string", "format": "uri"}, "operation": {"type": "string", "format": "uri"}, "support": {"type": "string", "format": "uri"}}}, "eventsProduced": {"type": "array", "items": {"type": "string"}}, "eventsConsumed": {"type": "array", "items": {"type": "string"}}}}
}
}
