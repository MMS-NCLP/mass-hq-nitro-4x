# Safe names and placeholders only. Never commit real values.
MASS_RUNTIME_ENV=development
MASS_DATABASE_URL=
MASS_DEPLOYMENT_TARGET=local
MASS_MEDIA_SOURCE_ROOT=
MASS_DEPLOYMENT_MODE=pre-launch-live-qa
MASS_BIND_HOST=127.0.0.1
MASS_PUBLIC_ORIGIN=

# Vercel + Supabase deployment adapter. Publishable key may identify the
# project; service-role and database credentials remain server/CLI only.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=
SUPABASE_STORAGE_BUCKET=dispatch-media

# One-time fresh-QA bootstrap inputs. MASS_BOOTSTRAP_USER_ID must identify an
# existing Supabase Auth user. The bootstrap command never creates passwords.
MASS_BOOTSTRAP_TENANT_ID=
MASS_BOOTSTRAP_TENANT_NAME=
MASS_BOOTSTRAP_USER_ID=
MASS_BOOTSTRAP_USER_EMAIL=

# Server-only Square seams. Empty values keep the provider unavailable.
SQUARE_ENVIRONMENT=sandbox
SQUARE_ACCESS_TOKEN=
SQUARE_WEBHOOK_SIGNATURE_KEY=
