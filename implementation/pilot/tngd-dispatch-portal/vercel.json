{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "cleanUrls": true,
  "rewrites": [
    { "source": "/pulse", "destination": "/index.html" },
    { "source": "/today", "destination": "/index.html" },
    { "source": "/customers", "destination": "/index.html" },
    { "source": "/intake", "destination": "/index.html" },
    { "source": "/calendar", "destination": "/index.html" },
    { "source": "/dispatch", "destination": "/index.html" },
    { "source": "/jobs", "destination": "/index.html" },
    { "source": "/inspection", "destination": "/index.html" },
    { "source": "/estimates", "destination": "/index.html" },
    { "source": "/authorization", "destination": "/index.html" },
    { "source": "/invoices", "destination": "/index.html" },
    { "source": "/warranty", "destination": "/index.html" },
    { "source": "/follow-up", "destination": "/index.html" },
    { "source": "/pipeline", "destination": "/index.html" },
    { "source": "/reports", "destination": "/index.html" },
    { "source": "/commerce", "destination": "/index.html" },
    { "source": "/administration", "destination": "/index.html" },
    { "source": "/settings", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'" }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    }
  ]
}
